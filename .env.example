# Copy these names into the workspace Secrets panel. Never paste real values here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional browser-specific names; otherwise the values above are used.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

PORT=8000

# Defaults to requiring sign-in and TOTP MFA.
REQUIRE_AUTH=true
REQUIRE_MFA=true
